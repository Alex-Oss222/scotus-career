  "records_dated_on_or_after_1996_06_13": [
    {
      "file": "terms/OT1995/records/Calderon_v_Moore_summary_review_1996-06-17.md",
      "date": "1996-06-17",
      "case": "Calderon v. Moore, No. 95-1612, 518 U.S. 149; appellate Nos. 95-99009 and 95-99013.",
      "result": "Certiorari granted on the mootness question; mootness judgment reversed and remanded, 9\u20130, with the amended dismissal of the actual appeals set aside. Moore's Rule 39/Rule 33.2 motion is granted independently."
    },
    {
      "file": "terms/OT1995/records/Gray_v_Netherland_merits_1996-06-20.md",
      "date": "1996-06-20",
      "case": "Gray v. Netherland, 518 U.S. 152, No. 95-6510; OT1995-084, chunk 8.",
      "result": "Reversed in part and remanded, 5-4, for restoration and implementation of conditional sentencing relief on the reopened meaningful-opportunity claim, subject to genuinely applicable unadjudicated statutory requirements; the independent Sorrell Brady dismissal remains undisturbed, 9-0. The old-rule holding has six joins."
    },
    {
      "file": "terms/OT1995/records/Jaffee_v_Redmond_merits_1996-06-13.md",
      "date": "1996-06-13",
      "case": "Jaffee v. Redmond, No. 95-266, 518 U.S. 1.",
      "result": "Affirmed, 8\u20131; the Seventh Circuit's new-trial judgment stands, with its case-specific balancing rule rejected."
    },
    {
      "file": "terms/OT1995/records/Koon_and_Powell_v_United_States_merits_1996-06-13.md",
      "date": "1996-06-13",
      "case": "Koon v. United States; Powell v. United States, Nos. 94-1664 and 94-8842, 518 U.S. 81.",
      "result": "Affirmed in part, reversed in part, and remanded in both dockets. All nine require further sentencing; the two disputed vulnerability and successive-prosecution grounds survive 5\u20134, employment is rejected 8\u20131, recidivism is rejected 9\u20130, and the separate five-level departure is sustained 9\u20130 with Stone joining that judgment only."
    },
    {
      "file": "terms/OT1995/records/Leavitt_v_Jane_L_certiorari_1996-06-17.md",
      "date": "1996-06-17",
      "case": "Leavitt v. Jane L., No. 95-1242.",
      "result": "Review granted on the appealed severability question and the separate fetal-survival method-duty question; supplemental briefing directed; no summary merits disposition. The matter remains pending."
    },
    {
      "file": "terms/OT1995/records/Melendez_v_United_States_merits_1996-06-17.md",
      "date": "1996-06-17",
      "case": "Melendez v. United States, No. 95-5661, 518 U.S. 120.",
      "result": "Third Circuit affirmed, 7\u20132; the 120-month sentence remains. O'Connor and Breyer would remand under their conditional, coordinated-Guidelines construction."
    },
    {
      "file": "terms/OT1995/records/Rise_v_Oregon_merits_1996-06-14.md",
      "date": "1996-06-14",
      "case": "Rise v. Oregon; review of Ninth Circuit No. 93-35521, 59 F.3d 1556. No separate Supreme Court docket is supplied.",
      "result": "Fourth Amendment ruling reversed and remanded, 6\u20133; general-process ruling vacated and conditionally remanded, 5\u20134; ex post facto ruling and Milligan's judgment for Knox and Pearce affirmed, each 9\u20130."
    },
    {
      "file": "terms/OT1995/records/Vera_and_consolidated_standing_1996-06-13.md",
      "date": "1996-06-13",
      "case": "Bush v. Vera; Lawson v. Vera; United States v. Vera, Nos. 94-805, 94-806 and 94-988.",
      "result": "Standing recognized for Blum, Powers, Thomas, Vera and Orcutt concerning their respective districts; Chen supplies no independent standing for the three-district relief. The three appeals are retained and existing lower relief is unchanged, 9\u20130; Stone concurs in the judgment under his express case-specific alternative."
    }
